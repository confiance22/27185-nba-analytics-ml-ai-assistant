# Copy this file to .env and fill in your real values.
# .env is listed in .gitignore and will never be committed.

# Get your free API key at https://www.balldontlie.io
BALLDONTLIE_API_KEY=your_api_key_here

# Snowflake connection (get these from your Snowflake account)
SNOWFLAKE_ACCOUNT=your_account_locator
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=NBA_WH
SNOWFLAKE_DATABASE=NBA_PROJECT
SNOWFLAKE_SCHEMA=PUBLIC

# Groq API key for the AI assistant (free at console.groq.com)
GROQ_API_KEY=your_actual_groq_key_here
