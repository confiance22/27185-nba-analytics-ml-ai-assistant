# Secrets - never commit real credentials
.env

# Python virtual environment
venv/
env/
.venv/

# Python cache
__pycache__/
*.pyc

# Locally cached raw API response (regenerated by extract.py)
data/raw/*.json

# Data exports (regenerated from Postgres)
exports/
*.csv

# Log files (regenerated by logging_setup.py)
logs/

# pytest cache
.pytest_cache/

# IDE
.vscode/
.idea/
