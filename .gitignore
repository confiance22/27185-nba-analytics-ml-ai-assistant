!tableau_data/*.csv

# Log files (regenerated by logging_setup.py)
logs/

# pytest cache
.pytest_cache/

# IDE
.vscode/
.idea/

# Personal notes (not for pushing)
NBA_PROJECT_EXPLAINED.md
SCHEDULE.md

# Report source (only the PDF is pushed)
Final_Project_Report_27185.docx

